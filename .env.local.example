NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── x402 (paid continue / extra shot) ─────────────────────────────────────────
# Receiving wallet for USDC micropayments
X402_PAY_TO=0x7832dDF0Cf78C8CB52804FF9dDC728fcbCc4f638

# CAIP-2 network (default in code: Base mainnet)
# Prod: eip155:8453   Dev/test: eip155:84532
X402_NETWORK=eip155:8453
NEXT_PUBLIC_X402_NETWORK=eip155:8453

# Facilitator
# Prod (CDP, requires API keys): https://api.cdp.coinbase.com/platform/v2/x402
# Dev (Sepolia, no auth):        https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Prices (USDC). Shown in confirm UI via NEXT_PUBLIC_* as well.
X402_PRICE_CONTINUE=$0.001
X402_PRICE_EXTRA=$0.0005
NEXT_PUBLIC_X402_PRICE_CONTINUE=$0.001
NEXT_PUBLIC_X402_PRICE_EXTRA=$0.0005

# CDP API keys required for mainnet facilitator
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
