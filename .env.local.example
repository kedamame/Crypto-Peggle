NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── x402 (paid continue / extra shot) ─────────────────────────────────────────
# Receiving wallet for USDC micropayments
X402_PAY_TO=0x7832dDF0Cf78C8CB52804FF9dDC728fcbCc4f638

# CAIP-2 network: Base Sepolia (dev) or Base mainnet (prod)
# Dev:  eip155:84532   Prod: eip155:8453
X402_NETWORK=eip155:84532
NEXT_PUBLIC_X402_NETWORK=eip155:84532

# Facilitator
# Dev (no auth): https://x402.org/facilitator
# Prod (CDP):    https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=https://x402.org/facilitator

# Prices (USDC). Defaults match product: Continue $0.001 / Extra $0.0005
X402_PRICE_CONTINUE=$0.001
X402_PRICE_EXTRA=$0.0005

# CDP API keys required only when using the CDP facilitator on mainnet
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
